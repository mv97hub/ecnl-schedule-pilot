POSTGRES_USER=ecnl
POSTGRES_PASSWORD=ecnl
POSTGRES_DB=ecnl
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecnl:ecnl@localhost:5432/ecnl
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Website process. Sign-in fails with a clear error when any of these are missing.
# Do not commit real values. Set the same names on the Render website service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
AUTH_INTERNAL_SECRET=

# API process. The same AUTH_INTERNAL_SECRET as the website, so the site can open a session.
# Sign-in fails when it is missing. There is no fallback value.
# AUTH_INTERNAL_SECRET=

# API process. Audiences for Google identity tokens from the phone.
# GOOGLE_IOS_CLIENT_ID is the iOS client in the same Google Cloud project as GOOGLE_CLIENT_ID.
# Android tokens use that public web client id as their audience. Set GOOGLE_CLIENT_ID on the
# API service as well (the id only; the secret stays on the website). Apple uses the app id.
GOOGLE_IOS_CLIENT_ID=

# Phone build. The same iOS client id. A device build uses it as the Google URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Phone build. The same public web client id as GOOGLE_CLIENT_ID. Android Google sign-in
# requests an identity token for this audience. Do not put GOOGLE_CLIENT_SECRET in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
